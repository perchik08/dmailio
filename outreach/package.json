{
  "name": "dmailio-outreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node --env-file=.env server.mjs",
    "format": "prettier --write \"*.mjs\" \"public/*\" \"test/*.mjs\"",
    "format:check": "prettier --check \"*.mjs\" \"public/*\" \"test/*.mjs\""
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "marked": "^18.0.13",
    "nodemailer": "^10.0.10",
    "quill": "^2.0.3",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
