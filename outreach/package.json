{
  "name": "dmailio-outreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node --env-file=.env server.mjs",
    "format": "prettier --write \"*.mjs\" \"public/*\" \"test/*.mjs\"",
    "format:check": "prettier --check \"*.mjs\" \"public/*\" \"test/*.mjs\"",
    "test:marketing:unit": "node scripts/marketing-tests.mjs unit",
    "test:marketing:integration": "node scripts/marketing-tests.mjs integration",
    "test:marketing:e2e": "node scripts/marketing-tests.mjs e2e",
    "format:marketing": "prettier --write marketing/ public/marketing/ scripts/ test/integration/ test/e2e/ playwright.config.mjs --ignore-unknown",
    "format:check:marketing": "prettier --check marketing/ public/marketing/ scripts/ test/integration/ test/e2e/ playwright.config.mjs --ignore-unknown",
    "build:marketing:builder": "node scripts/build-marketing-builder.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "csv-parse": "^7.0.2",
    "exceljs": "4.4.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "marked": "^18.0.13",
    "nodemailer": "^10.0.10",
    "omggif": "^1.0.10",
    "pg": "8.23.1",
    "quill": "^2.0.3",
    "sanitize-html": "^2.17.7",
    "ssf": "0.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
